# Foundation X — unconditional BRAVE on tap (128-D, no Fader).
#
# Inherits silence-kept + RandomGain (−12…+6 dB relative, prob 1, limit)
# from brave.gin. Do not peak-norm / do not pass --normalize.
#
# Variants:
#   shotgun-only:   tap_foundation_x_shotgun
#                   LMDB $BRAVE_STORAGE/tap_samples/preprocessed_shotgun
#   shotgun+contact: tap_foundation_x_shotgun_contact
#                   LMDB $BRAVE_STORAGE/tap_samples/preprocessed_shotgun_contact
#                   (single LMDB from audio_subset_shotgun + audio_subset_clean)
#
#   bash scripts/submit_foundation_x_train.sh
#
# Joint LMDB (preprocess separately, then train):
#   INPUT_PATH=$BRAVE_STORAGE/tap_samples/audio_subset_shotgun \
#   INPUT_PATH_EXTRA=$BRAVE_STORAGE/tap_samples/audio_subset_clean \
#   OUTPUT_PATH=$BRAVE_STORAGE/tap_samples/preprocessed_shotgun_contact \
#   NORMALIZE=0 sbatch --chdir=/data/hai-res/p1long/BRAVE scripts/preprocess.sbatch
#
# Foundation Y (playlists): bash scripts/submit_foundation_y_batch.sh
#
# Eval ckpt: epoch_1500000.ckpt (1.5M steps).

include "brave.gin"
