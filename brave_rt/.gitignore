# Local builds / artefacts
cpp/**/build*/
cpp/**/BraveRT_artefacts/
cpp/**/*.log
cpp/**/*.o
cpp/**/*.a
**/__pycache__/
*.pyc

# Packaged Mac/Linux zips (rebuild with dist scripts)
dist/*.zip
dist/BraveRT_mac_dist/

# Trim vendored JUCE (not needed to build the plugin)
third_party/JUCE/examples/
third_party/JUCE/extras/Projucer/
third_party/JUCE/.git/
third_party/JUCE/.github/

# Optional local scratch
*.user
.DS_Store

# Local Linux cross/sysroot deps (not part of the host)
third_party/linux_sysroot/

# JUCE demos / Android Firebase configs (trigger GitHub secret scanning;
# JUCE's public DemoRunner key, not a BRAVE credential)
third_party/JUCE/extras/AudioPluginHost/
**/google-services.json
